<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZhihuHub.Avalonia.ViewModels"
             x:Class="ZhihuHub.Avalonia.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="搜索"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20" />

        <!-- 搜索控件 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <!-- 搜索类型 -->
            <ComboBox SelectedIndex="{Binding SelectedSearchType}"
                      Width="140"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="知乎搜索" />
                <ComboBoxItem Content="全网搜索" />
            </ComboBox>

            <!-- 搜索框 -->
            <TextBox Text="{Binding SearchQuery}"
                     Watermark="输入搜索关键词"
                     Width="400"
                     VerticalAlignment="Center" />

            <!-- 搜索按钮 -->
            <Button Content="🔍 搜索"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding !IsSearching}"
                    Background="#0084FF"
                    Foreground="White"
                    Padding="20,8"
                    CornerRadius="4"
                    Cursor="Hand" />
        </StackPanel>

        <!-- 状态信息 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="13"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,15" />

        <!-- 搜索结果 -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0,0,0,12"
                                BoxShadow="0 1 4 0 #10000000"
                                Cursor="Hand">
                            <StackPanel Spacing="8">
                                <!-- 标题 -->
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2C3E50"
                                           TextWrapping="Wrap" />

                                <!-- 作者 -->
                                <TextBlock FontSize="12"
                                           Foreground="#7F8C8D">
                                    <Run Text="👤" />
                                    <Run Text="{Binding AuthorName}" />
                                </TextBlock>

                                <!-- 摘要 -->
                                <TextBlock Text="{Binding ContentText}"
                                           FontSize="13"
                                           Foreground="#2C3E50"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
