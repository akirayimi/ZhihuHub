<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZhihuHub.Avalonia.ViewModels"
             x:Class="ZhihuHub.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer>
        <StackPanel Spacing="30" Margin="20">
            <!-- 欢迎标题 -->
            <TextBlock Text="{Binding WelcomeMessage}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#2C3E50" />

            <!-- 副标题 -->
            <TextBlock Text="{Binding SubtitleMessage}"
                       FontSize="16"
                       Foreground="#7F8C8D" />

            <!-- 功能卡片 -->
            <WrapPanel>
                <!-- 搜索卡片 -->
                <Border Width="220" Height="180"
                        Background="White"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,20,20"
                        BoxShadow="0 2 8 0 #10000000">
                    <StackPanel Spacing="15">
                        <TextBlock Text="🔍" FontSize="36" />
                        <TextBlock Text="智能搜索"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50" />
                        <TextBlock Text="搜索知乎内容和全网资源"
                                   FontSize="12"
                                   Foreground="#7F8C8D"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 热榜卡片 -->
                <Border Width="220" Height="180"
                        Background="White"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,20,20"
                        BoxShadow="0 2 8 0 #10000000">
                    <StackPanel Spacing="15">
                        <TextBlock Text="🔥" FontSize="36" />
                        <TextBlock Text="实时热榜"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50" />
                        <TextBlock Text="掌握知乎热点动态"
                                   FontSize="12"
                                   Foreground="#7F8C8D"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 我的知乎卡片 -->
                <Border Width="220" Height="180"
                        Background="White"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,20,20"
                        BoxShadow="0 2 8 0 #10000000">
                    <StackPanel Spacing="15">
                        <TextBlock Text="👤" FontSize="36" />
                        <TextBlock Text="我的知乎"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50" />
                        <TextBlock Text="管理创作、关注和收藏"
                                   FontSize="12"
                                   Foreground="#7F8C8D"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 知识库卡片 -->
                <Border Width="220" Height="180"
                        Background="White"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,20,20"
                        BoxShadow="0 2 8 0 #10000000">
                    <StackPanel Spacing="15">
                        <TextBlock Text="📚" FontSize="36" />
                        <TextBlock Text="知识库"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50" />
                        <TextBlock Text="浏览和搜索知识库"
                                   FontSize="12"
                                   Foreground="#7F8C8D"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 版本信息 -->
            <TextBlock Text="{Binding VersionInfo}"
                       FontSize="12"
                       Foreground="#7F8C8D"
                       Margin="0,50,0,0" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
