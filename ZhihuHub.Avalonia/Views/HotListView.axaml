<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZhihuHub.Avalonia.ViewModels"
             x:Class="ZhihuHub.Avalonia.Views.HotListView"
             x:DataType="vm:HotListViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- 标题和刷新按钮 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0"
                       Text="知乎热榜"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="🔄 刷新"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Background="#0084FF"
                    Foreground="White"
                    Padding="16,8"
                    CornerRadius="4"
                    Cursor="Hand" />
        </Grid>

        <!-- 更新时间 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding LastUpdateTime}"
                   FontSize="12"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,10" />

        <!-- 状态信息 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="13"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,15" />

        <!-- 热榜列表 -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding HotItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0,0,0,10"
                                BoxShadow="0 1 4 0 #10000000"
                                Cursor="Hand">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 排名 -->
                                <Border Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        CornerRadius="25"
                                        Background="#FFF5F5"
                                        Margin="0,0,20,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Rank}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#FF5733"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- 内容 -->
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <!-- 标题 -->
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#2C3E50"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />

                                    <!-- 摘要 -->
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="12"
                                               Foreground="#7F8C8D"
                                               TextWrapping="Wrap"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
